{
  "name": "tiqui-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check:build": "node scripts/build.js --check",
    "test": "npm run check:build && npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:browser": "node tests/run-playwright.js",
    "test:browser:ui": "node tests/run-playwright.js --ui",
    "test:media-performance": "node tests/run-playwright.js tests/performance/media-package.spec.js --project=chromium --workers=1",
    "test:install-browser": "node tests/install-browser.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "fflate": "0.8.3"
  }
}
